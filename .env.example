# Mock data (MSW) — true = fixtures, false = real backend
VITE_USE_MOCKS=true

# Base URL of the Django backend. Leave empty to use the Vite dev proxy (/api -> 127.0.0.1:8000)
# Set explicitly when calling the API from another origin (e.g. deployed control-plane).
# VITE_API_BASE_URL=http://127.0.0.1:8000
